# 后端环境变量示例
# 复制为 .env 并填入真实值

# 服务配置
HOST=0.0.0.0
PORT=8000
ENV=development

# Supabase配置
SUPABASE_URL=https://iyucjdommuqxksuutntm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# DeepSeek配置（用于分析/设计）
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Coder模型配置（用于代码生成，OpenAI兼容接口）
CODER_API_KEY=your_coder_api_key
CODER_BASE_URL=https://api.ofox.ai/v1
CODER_MODEL=openai/gpt-5.5

# 前端地址（CORS）
FRONTEND_URL=http://localhost:3000
